{
  "name": "dhedge-v2",
  "version": "1.0.0",
  "description": "dHEDGE V2 smart contracts",
  "scripts": {
    "lint": "pnpm lint:sol && eslint . --max-warnings=0",
    "lint:sol": "solhint 'contracts/**/*.sol' && solhint 'test/**/*.sol' --config test/.solhint.test.json",
    "format": "prettier -w --plugin=prettier-plugin-solidity '**/*.{js,ts,sol,json,md}'",
    "prettier:check": "prettier -l --plugin=prettier-plugin-solidity '**/*.{js,ts,sol,json,md}'",
    "check:foundry-version": "scripts/utils/checkFoundryVersion.sh",
    "compile": "pnpm check:foundry-version && hardhat compile",
    "test": "pnpm check:foundry-version && forge test --no-match-path \"**/ffi/**\"",
    "test:ffi": "pnpm check:foundry-version && FOUNDRY_PROFILE=ffi-tests forge test --match-path \"**/ffi/**/*.t.sol\"",
    "check:polygon:ownership": "hardhat checkConfig --specific true --ownership true --network polygon",
    "check:polygon:factory": "hardhat checkConfig --specific true --factory true --network polygon",
    "check:polygon:governance": "hardhat checkConfig --specific true --governance true --network polygon",
    "check:polygon:assets": "hardhat checkConfig --specific true --assets true --network polygon",
    "check:polygon:bytecode": "hardhat checkConfig --specific true --bytecode true --network polygon",
    "check:polygon:all": "hardhat checkConfig --network polygon",
    "check:ovm:all": "hardhat checkConfig --network ovm",
    "dynamicbonds:polygon:getconfig": "hardhat dynamicBonds --get-config true --network polygon",
    "dynamicbonds:polygon:updateterms": "hardhat dynamicBonds --update-terms true --network polygon",
    "check:twaps": "hardhat run scripts/assets/twapOraclesCheck.ts",
    "check:twaps:ci": "pnpm check:twaps --network arbitrum && pnpm check:twaps --network base && pnpm check:twaps --network ethereum && pnpm check:twaps --network ovm && pnpm check:twaps --network polygon",
    "check:oracles": "hardhat run scripts/assets/oraclesReturnPriceCheck.ts",
    "check:oracles:ci": "pnpm check:oracles --network arbitrum && pnpm check:oracles --network base && pnpm check:oracles --network ethereum && pnpm check:oracles --network ovm && pnpm check:oracles --network polygon",
    "check:slippage": "hardhat run scripts/slippage/slippageMonitor.ts",
    "check:slippage:ci": "pnpm check:slippage --network arbitrum && pnpm check:slippage --network base && pnpm check:slippage --network ethereum && pnpm check:slippage --network hyperevm && pnpm check:slippage --network ovm && pnpm check:slippage --network polygon",
    "abigen": "hardhat export-abi",
    "error-registry:generate": "forge build --skip test --force && ts-node scripts/errorRegistry/generate.ts",
    "error-registry:check": "ts-node scripts/errorRegistry/generate.ts --check",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm compile",
    "prepare": "husky install"
  },
  "author": "dHEDGE Team",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-foundry": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.0.14",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@openzeppelin/hardhat-upgrades": "1.17.0",
    "@openzeppelin/upgrades-core": "^1.34.1",
    "@safe-global/api-kit": "^4.0.0",
    "@safe-global/protocol-kit": "^6.1.1",
    "@typechain/ethers-v5": "^8.0.5",
    "@typechain/hardhat": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^5.14.0",
    "@typescript-eslint/parser": "5.14.0",
    "axios": "^1.18.0",
    "csv-stringify": "^5.6.2",
    "csvtojson": "^2.0.14",
    "decimal.js": "^10.4.3",
    "dotenv": "^17.4.2",
    "eslint": "8.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "ethers": "5.7.2",
    "hardhat": "2.28.6",
    "hardhat-abi-exporter": "^2.2.1",
    "husky": "^8.0.1",
    "lint-staged": "^13.2.1",
    "prettier": "^3.8.1",
    "prettier-plugin-solidity": "^1.4.2",
    "solhint": "^5.1.0",
    "ts-node": "^10.3.0",
    "typechain": "^6.0.5",
    "typescript": "4.3.5"
  },
  "dependencies": {
    "@chainlink/contracts": "^0.1.4",
    "@openzeppelin/contracts": "3.4.2-solc-0.7",
    "@openzeppelin/contracts-upgradeable": "3.4.2-solc-0.7",
    "@uniswap/v3-core": "^1.0.0",
    "@uniswap/v3-periphery": "^1.4.4"
  },
  "lint-staged": {
    "contracts/**/*.sol": [
      "solhint -w 0",
      "prettier --write --plugin=prettier-plugin-solidity"
    ],
    "test/**/*.sol": [
      "solhint --config test/.solhint.test.json -w 0",
      "prettier --write --plugin=prettier-plugin-solidity"
    ],
    "*.{ts,js,json,md}": [
      "prettier --write"
    ],
    "*.ts": "eslint --max-warnings=0",
    "*.js": "eslint --cache --fix",
    "{contracts/**/*.sol,config/**/*.{csv,json},readmes/errorCodes/overlay.json}": "pnpm error-registry:check"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a"
}
